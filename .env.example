NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://clovent:clovent_secret@localhost:5432/clovent

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_me_jwt_secret_at_least_64_chars_long_xxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_64_chars_long_xxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage (S3 / Cloudflare R2)
S3_BUCKET=clovent-uploads
S3_REGION=auto
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# AI (optional external API — system works without this)
AI_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email (Resend / SendGrid)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=noreply@clovent.ai

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Feature Flags
ENABLE_AI_SCORING=true
ENABLE_EMAIL_AUTOMATION=true
ENABLE_SMS_AUTOMATION=false
IMPORT_MAX_FILE_SIZE_MB=100
IMPORT_BATCH_SIZE=500
